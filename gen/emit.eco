/**
 * Emitters. A line is interpolated, then appended. Interpolation-in-a-loop
 * against the accumulating buffer is the documented O(n²) trap; `reserve`
 * plus append of a finished line is the way out.
 */

namespace glfwgen::emit;

use glfwgen::model;
use glfwgen::overrides;

public const string GLFW_VERSION = '3.4';
public const string GLFW_SHA256 = 'b5ec004b2712fd08e8861dc271428f048775200a2df719ccf575143ba749a3e9';

public struct Banner
{
    string $invocation;
    string $version;
    string $sha256;

    constructor()
    {
        $this->invocation = '';
        $this->version = '';
        $this->sha256 = '';
    }
}

public struct Emitted
{
    string $source;
    usize $n_consts;
    usize $n_structs;
    usize $n_callbacks;
    usize $n_funcs;

    constructor()
    {
        $this->source = '';
        $this->n_consts = 0;
        $this->n_structs = 0;
        $this->n_callbacks = 0;
        $this->n_funcs = 0;
    }
}

public function emit_module(const model::Model& $m, const Banner& $banner) : result<Emitted, string>
{
    result<bool, string> $honest = check_policy($m);

    if ($honest->failed()) {
        return .error($honest->failure());
    }

    Emitted $out = Emitted();
    $out->n_consts = $m->consts->count();
    $out->n_structs = count_emitted_structs($m);
    $out->n_callbacks = $m->callbacks->count();
    $out->n_funcs = $m->funcs->count();
    $out->source->reserve(262144);

    emit_banner($out->source, $banner, $out);
    $out->source->append("namespace glfw;\n\n");
    emit_constants($out->source, $m);
    emit_structs($out->source, $m);
    emit_callback_comment($out->source, $m);
    emit_extern($out->source, $m);
    $out->source->append('\n');
    emit_wrappers($out->source, $m);

    return .ok($out);
}

function count_emitted_structs(const model::Model& $m) : usize
{
    usize $n = 0;
    usize $i = 0;

    while ($i < $m->structs->count()) {
        if (!$m->structs[$i]->hand_written) {
            $n = $n + 1;
        }

        $i = $i + 1;
    }

    return $n;
}

function check_policy(const model::Model& $m) : result<bool, string>
{
    ordered_map<string, bool> $have = ordered_map<string, bool>();
    usize $i = 0;

    while ($i < $m->funcs->count()) {
        $have[$m->funcs[$i]->c_name] = true;
        $i = $i + 1;
    }

    array<string> $names = overrides::keep_c_string_names();
    $i = 0;

    while ($i < $names->count()) {
        string $name = $names[$i];

        if (!$have->has($name)) {
            return .error("keep_c_string name '{$name}' matches no prototype in glfw3.h");
        }

        $i = $i + 1;
    }

    return .ok(true);
}

function emit_banner(string& $out, const Banner& $b, const Emitted& $em) : void
{
    $out->append("// Generated by libglfw generate. Do not edit.\n");
    string $line = "// {$b->invocation}\n";
    $out->append($line);
    $line = "// glfw: {$b->version} ({$b->sha256})\n";
    $out->append($line);
    $line = "// {$em->n_consts} constants, {$em->n_structs} structs, {$em->n_callbacks} callbacks, {$em->n_funcs} functions\n\n";
    $out->append($line);
}

function emit_constants(string& $out, const model::Model& $m) : void
{
    usize $i = 0;

    while ($i < $m->consts->count()) {
        model::Constant $c = $m->consts[$i];
        string $line = "public const int32 {$c->echo_name} = {$c->value};\n";
        $out->append($line);
        $i = $i + 1;
    }

    $out->append('\n');
}

function emit_structs(string& $out, const model::Model& $m) : void
{
    usize $i = 0;

    while ($i < $m->structs->count()) {
        model::StructDef $s = $m->structs[$i];

        if ($s->hand_written) {
            $i = $i + 1;
            continue;
        }

        if ($s->fields->count() == 0) {
            string $note = "// Opaque. A ptr<{$s->echo_name}> is a {$s->c_name}*; never construct one.\n";
            $out->append($note);
        }

        string $line = "public struct {$s->echo_name}\n";
        $out->append($line);
        $out->append("{\n");
        usize $f = 0;

        while ($f < $s->fields->count()) {
            $line = "    {$s->fields[$f]->echo_type} ${$s->fields[$f]->echo_name};\n";
            $out->append($line);
            $f = $f + 1;
        }

        $out->append("}\n\n");
        $i = $i + 1;
    }
}

function emit_callback_comment(string& $out, const model::Model& $m) : void
{
    $out->append("// Callback spellings (not distinct Echo types):\n");
    usize $i = 0;

    while ($i < $m->callbacks->count()) {
        string $line = "//   {$m->callbacks[$i]->c_name}  = {$m->callbacks[$i]->echo_type}\n";
        $out->append($line);
        $i = $i + 1;
    }

    $out->append('\n');
}

function emit_extern(string& $out, const model::Model& $m) : void
{
    $out->append("internal extern {\n");
    usize $i = 0;

    while ($i < $m->funcs->count()) {
        model::Func $fn = $m->funcs[$i];
        string $args = extern_args($fn);
        string $line = "    function {$fn->c_name} as c_{$fn->echo_name}({$args}) : {$fn->ret_extern};\n";
        $out->append($line);
        $i = $i + 1;
    }

    $out->append("}\n");
}

function emit_wrappers(string& $out, const model::Model& $m) : void
{
    usize $i = 0;

    while ($i < $m->funcs->count()) {
        model::Func $fn = $m->funcs[$i];

        if ($fn->skip_wrapper) {
            $i = $i + 1;
            continue;
        }

        string $args = wrapper_args($fn);
        string $call = call_args($fn);
        string $line = "#[inline]\npublic function {$fn->echo_name}({$args}) : {$fn->ret_echo}\n";
        $out->append($line);
        $out->append("{\n");

        if ($fn->str_out) {
            $line = "    return __str_or_empty(c_{$fn->echo_name}({$call}));\n";
        } else if ($fn->ret_echo == 'void') {
            $line = "    c_{$fn->echo_name}({$call});\n";
        } else {
            $line = "    return c_{$fn->echo_name}({$call});\n";
        }

        $out->append($line);
        $out->append("}\n\n");
        $i = $i + 1;
    }
}

function extern_args(const model::Func& $fn) : string
{
    string $args = '';
    usize $p = 0;

    while ($p < $fn->params->count()) {
        if ($p > 0) {
            $args->append(', ');
        }

        $args->append($fn->params[$p]->extern_type);
        $args->append(" ${$fn->params[$p]->echo_name}");
        $p = $p + 1;
    }

    return $args;
}

function wrapper_args(const model::Func& $fn) : string
{
    string $args = '';
    usize $p = 0;

    while ($p < $fn->params->count()) {
        if ($p > 0) {
            $args->append(', ');
        }

        $args->append($fn->params[$p]->echo_type);
        $args->append(" ${$fn->params[$p]->echo_name}");
        $p = $p + 1;
    }

    return $args;
}

function call_args(const model::Func& $fn) : string
{
    string $call = '';
    usize $p = 0;

    while ($p < $fn->params->count()) {
        if ($p > 0) {
            $call->append(', ');
        }

        $call->append("${$fn->params[$p]->echo_name}");

        if ($fn->params[$p]->to_cstr) {
            $call->append('->cstr()');
        }

        $p = $p + 1;
    }

    return $call;
}
